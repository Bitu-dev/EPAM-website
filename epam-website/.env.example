# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- required ---
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_base64_at_least_32_bytes
# Your domain: Caddy obtains a TLS certificate for it automatically. Leave as :80 for local testing.
SITE_ADDRESS=www.example.org
PUBLIC_URL=https://www.example.org

# --- email notifications for new inquiries (strongly recommended: otherwise nobody is told) ---
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465
SMTP_URL=
SMTP_FROM="EPAM Website <noreply@example.org>"
NOTIFY_TO=team@example.org

# --- first admin: used ONCE, only if the users table is empty. Remove these after first sign-in. ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# --- optional ---
# COOKIE_SECURE=false      # only for plain-HTTP local testing
